<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>STORYCAST AI PRO — Cinema Studio</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');
    body {
      font-family: 'Inter', sans-serif;
      background-color: #060a12;
      color: #e2e8f0;
    }
    .mono { font-family: 'JetBrains Mono', monospace; }
    @keyframes kenburns {
      0% { transform: scale(1.0) translate(0, 0); }
      100% { transform: scale(1.12) translate(-1.5%, -1%); }
    }
    .animate-dolly {
      animation: kenburns 6s ease-out forwards;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col items-center p-2 md:p-5">

  <!-- App Container -->
  <div class="w-full max-w-xl bg-[#0b111e] border border-slate-800 rounded-2xl shadow-2xl overflow-hidden">

    <!-- Header -->
    <header class="flex items-center justify-between px-4 py-3 bg-[#080d17] border-b border-slate-800">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-cyan-500/15 border border-cyan-400/40 flex items-center justify-center text-cyan-400">
          🎬
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="text-xs font-bold tracking-wider text-white">STORYCAST AI PRO</span>
            <span class="text-[10px] px-1.5 py-0.2 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 mono">VEO 3.1 + KLING</span>
          </div>
          <p id="connStatus" class="text-[10px] text-slate-400 mono">Multi-Shot Cinema Pipeline Ready</p>
        </div>
      </div>
      <div class="flex items-center gap-1.5">
        <button onclick="toggleModal('apiModal')" class="px-2.5 py-1.5 rounded-lg text-[11px] font-semibold bg-slate-800 hover:bg-slate-700 text-cyan-300 border border-slate-700">
          ⚙️ APIs
        </button>
        <button onclick="stitchAndPlayFullMovie()" class="px-3 py-1.5 rounded-lg text-[11px] font-bold bg-gradient-to-r from-amber-400 to-orange-400 text-slate-950 shadow">
          🎞️ Play Full Movie
        </button>
      </div>
    </header>

    <!-- Navigation Tabs -->
    <div class="grid grid-cols-3 gap-1 p-1.5 bg-[#090e1a] border-b border-slate-800 text-xs font-medium">
      <button onclick="switchTab('studio')" id="tabBtn-studio" class="py-1.5 rounded-lg bg-cyan-500/15 text-cyan-300 border border-cyan-500/40">
        🎥 Studio Player
      </button>
      <button onclick="switchTab('script')" id="tabBtn-script" class="py-1.5 rounded-lg text-slate-400 hover:text-white">
        📄 Script & Cast (<span id="castBadgeCount">2</span>)
      </button>
      <button onclick="switchTab('mixer')" id="tabBtn-mixer" class="py-1.5 rounded-lg text-slate-400 hover:text-white">
        🎚️ Audio & SFX Mixer
      </button>
    </div>

    <!-- TAB 1: STUDIO PLAYER & TIMELINE (Matches & Upgrades Your Screenshot) -->
    <section id="tab-studio" class="p-3.5 space-y-3.5">

      <!-- Top Render Controls Bar -->
      <div class="bg-[#101829] border border-slate-800/90 rounded-xl p-3 space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
          <select id="resSelect" class="bg-[#090f1c] border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-slate-200">
            <option value="720p">720p HD</option>
            <option value="1080p" selected>1080p Full HD</option>
            <option value="4k">4K Cinema</option>
          </select>
          <select id="durSelect" class="bg-[#090f1c] border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-slate-200">
            <option value="4">4s Clip</option>
            <option value="5" selected>5s Clip</option>
            <option value="10">10s Clip</option>
          </select>
          <select id="engineSelect" class="bg-[#090f1c] border border-cyan-500/40 rounded-lg px-2.5 py-1.5 text-xs text-cyan-300 flex-1">
            <option value="fal-ai/veo3">Veo 3.1 Realistic Cinema</option>
            <option value="fal-ai/kling-video/v2/master/image-to-video">Kling 3.0 Master (Face Lock)</option>
          </select>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <button onclick="renderActiveShot()" class="px-3.5 py-1.5 rounded-lg text-xs font-bold bg-gradient-to-r from-cyan-400 to-amber-400 text-slate-950 flex items-center gap-1.5 shadow">
            ✨ Render Realistic Video
          </button>
          <button onclick="extendActiveShot()" class="px-2.5 py-1.5 rounded-lg text-xs font-medium bg-slate-800/90 hover:bg-slate-700 text-cyan-300 border border-slate-700">
            ♾️ +5s Extend
          </button>
          <label class="px-2.5 py-1.5 rounded-lg text-xs font-medium bg-slate-800/90 hover:bg-slate-700 text-slate-300 border border-slate-700 cursor-pointer">
            ↑ Load MP4
            <input type="file" accept="video/mp4,video/*" class="hidden" onchange="loadCustomMp4(event)" />
          </label>
          <label class="px-2.5 py-1.5 rounded-lg text-xs font-medium bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-300 border border-emerald-500/30 cursor-pointer">
            🖼️ Keyframe Img
            <input type="file" accept="image/*" class="hidden" onchange="loadCustomKeyframe(event)" />
          </label>
        </div>
      </div>

      <!-- Camera & Scene Preset Bar -->
      <div class="bg-[#101829] border border-slate-800/90 rounded-xl p-3 flex flex-wrap items-center justify-between gap-2">
        <div class="flex flex-wrap items-center gap-2">
          <select id="lookSelect" onchange="applyColorGrade()" class="bg-[#090f1c] border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-amber-300">
            <option value="sepia(0.18) contrast(1.08) saturate(1.15)">Golden Hour Orchard</option>
            <option value="contrast(1.2) saturate(0.85) brightness(0.95)">35mm Kodak Film</option>
            <option value="hue-rotate(170deg) saturate(1.4) contrast(1.15)">Cyberpunk Neon</option>
          </select>
          <select id="cameraMoveSelect" onchange="updateActiveCameraMove(this.value)" class="bg-[#090f1c] border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-slate-200">
            <option value="Wide Aerial Drone Pan [0.8x]">Wide Aerial Drone Pan [0.8x]</option>
            <option value="Medium Two-Shot | 50mm Prime">Medium Two-Shot | 50mm Prime</option>
            <option value="Over-The-Shoulder Close-Up">Over-The-Shoulder Close-Up</option>
            <option value="Low Angle Rear Tracking Shot">Low Angle Rear Tracking Shot</option>
          </select>
        </div>
        <div class="flex items-center gap-1.5 text-[11px] mono">
          <span class="px-2 py-1 rounded bg-cyan-500/15 text-cyan-300 border border-cyan-500/30">16:9</span>
          <button id="loopToggleBtn" onclick="toggleLoop()" class="px-2 py-1 rounded bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
            Loop: ON
          </button>
        </div>
      </div>

      <!-- PHOTOREALISTIC CINEMA VIEWPORT -->
      <div id="viewportContainer" class="relative w-full aspect-video bg-black rounded-xl overflow-hidden border border-slate-700 shadow-inner">
        <!-- Real MP4 Video Element -->
        <video id="videoPlayer" class="hidden w-full h-full object-cover" playsinline></video>

        <!-- Photorealistic Keyframe Layer (Replaces flat 2D cartoon canvas) -->
        <img id="keyframeImg" src="" alt="Cinematic Keyframe" class="w-full h-full object-cover animate-dolly transition-all duration-500" />

        <!-- Cinematic Vignette & Gradient Overlay -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-transparent to-black/50 pointer-events-none"></div>

        <!-- Top HUD Overlays -->
        <div class="absolute top-2.5 left-2.5 right-2.5 flex items-start justify-between gap-2 pointer-events-none">
          <div class="px-2.5 py-1.5 rounded-lg bg-slate-950/80 backdrop-blur-md border border-slate-700/80 text-[11px] mono">
            <div id="hudStreamTitle" class="text-cyan-300 font-semibold">Veo 3.1 Realistic Cinema Stream • 1080p</div>
            <div id="hudCameraSub" class="text-[10px] text-slate-400">🎥 Wide Aerial Drone Pan [0.8x]</div>
          </div>
          <div class="flex items-center gap-1.5">
            <div class="px-2 py-1 rounded-lg bg-emerald-950/85 border border-emerald-500/40 text-[10px] text-emerald-300 mono leading-tight">
              LIP-SYNC:<br/><strong>ACTIVE</strong>
            </div>
            <div class="px-2.5 py-1 rounded-lg bg-slate-950/85 border border-slate-700 text-[11px] text-slate-200 mono">
              <span id="timeElapsed">0.0s</span> / <span id="timeTotal">5.0s</span>
            </div>
          </div>
        </div>

        <!-- Locked Character Face Badges on Viewport -->
        <div id="viewportCastBadges" class="absolute top-16 left-2.5 flex gap-1.5 pointer-events-none"></div>

        <!-- Live Subtitle Overlay -->
        <div class="absolute bottom-14 inset-x-4 text-center pointer-events-none">
          <div class="inline-block px-3 py-1.5 rounded-lg bg-black/75 backdrop-blur-sm border border-white/10 text-xs leading-snug max-w-md">
            <span id="subSpeaker" class="text-cyan-400 font-bold mono mr-1">ARTHUR:</span>
            <span id="subText" class="text-white">"You taking that heap? They judge an apple by how shiny the wax is, not the root."</span>
          </div>
        </div>

        <!-- Scrubber & Transport Controls -->
        <div class="absolute bottom-0 inset-x-0 p-2.5 bg-gradient-to-t from-black/95 to-transparent space-y-1.5">
          <input id="scrubber" type="range" min="0" max="100" value="0" oninput="scrubTimeline(this.value)"
            class="w-full h-1.5 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-cyan-400" />
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-1.5">
              <button id="playPauseBtn" onclick="togglePlayShot()" class="w-8 h-7 rounded-lg bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-bold text-xs flex items-center justify-center">
                ▶
              </button>
              <button onclick="cycleSpeed()" id="speedBtn" class="px-2 py-1 rounded-lg bg-slate-800/90 text-[11px] text-slate-200 border border-slate-700 mono">
                1.0x
              </button>
              <button onclick="triggerShotSfx()" class="px-2 py-1 rounded-lg bg-amber-500/20 text-[11px] text-amber-300 border border-amber-500/30 mono" title="Trigger Shot SFX">
                🔊 SFX
              </button>
            </div>
            <div class="flex items-center gap-1.5">
              <button onclick="downloadActiveShotInfo()" class="px-2.5 py-1 rounded-lg bg-slate-800/90 hover:bg-slate-700 text-[11px] text-slate-200 border border-slate-700">
                ↓ Save Video
              </button>
              <button onclick="toggleFullscreen()" class="px-2 py-1 rounded-lg bg-slate-800/90 hover:bg-slate-700 text-xs text-slate-200 border border-slate-700">
                ⛶
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Scene Table Read & Voice Sync Card -->
      <div class="bg-[#101829] border border-slate-800 rounded-xl p-3 flex items-center justify-between gap-3">
        <div>
          <div class="text-xs font-bold text-white flex items-center gap-1.5">
            Scene Table Read & Multi-Track Sync
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-purple-500/20 text-purple-300 mono">Auto-Duck ON</span>
          </div>
          <p class="text-[11px] text-slate-400">Plays character voice + acoustic guitar score + scene SFX</p>
        </div>
        <button onclick="auditionCurrentShot()" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40 whitespace-nowrap">
          🔊 Audition Scene
        </button>
      </div>

      <!-- INTERACTIVE MULTI-SHOT TIMELINE -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-bold tracking-wider text-slate-300 mono">
            🎞️ INTERACTIVE MULTI-SHOT TIMELINE (<span id="shotTotalBadge">3</span> SHOTS)
          </span>
          <div class="flex items-center gap-2">
            <button onclick="renderAllShotsBatch()" class="text-[11px] text-emerald-400 hover:underline mono font-semibold">
              ⚡ Render All
            </button>
            <button onclick="addNewBlankShot()" class="text-[11px] text-cyan-400 hover:underline mono font-semibold">
              ⊕ Add Blank Shot
            </button>
          </div>
        </div>

        <div id="shotTimelineList" class="space-y-2"></div>

        <!-- Stitch & Export Full Movie Button -->
        <button onclick="stitchAndPlayFullMovie()" class="w-full py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider bg-gradient-to-r from-emerald-400 via-cyan-400 to-amber-400 text-slate-950 shadow-lg hover:opacity-95 transition">
          🎬 Stitch & Play All Shots Sequentially (Full Scene)
        </button>
      </div>
    </section>

    <!-- TAB 2: SCRIPT & UNLOCKED CAST STUDIO -->
    <section id="tab-script" class="hidden p-4 space-y-4">
      <div class="bg-[#101829] border border-slate-800 rounded-xl p-3 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-cyan-400">📄 Master Screenplay</span>
          <button onclick="autoBreakScriptIntoShots()" class="px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">
            ✨ Sync Script → Shots
          </button>
        </div>
        <textarea id="masterScript" rows="5" class="w-full bg-[#070b14] border border-slate-700 rounded-lg p-2.5 text-xs text-slate-200 mono outline-none">EXT. APPLE ORCHARD - MORNING
@Arthur: "You taking that heap? They judge an apple by how shiny the wax is, not the root."
@Marcus: "The turbo's for hauling grain, Dad." [SFX: Trunk Slam]
@Arthur: "Then let 'em choke on the wax."</textarea>
      </div>

      <!-- Unlocked Cast List -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-white">🔓 Unlocked Cast (Face & Voice Reference)</span>
          <button onclick="addCastMember()" class="px-2.5 py-1 rounded-lg text-[11px] font-bold bg-cyan-500 text-slate-950">+ Add Actor</button>
        </div>
        <div id="castStudioList" class="space-y-2"></div>
      </div>
    </section>

    <!-- TAB 3: 3-TRACK AUDIO & SFX MIXER -->
    <section id="tab-mixer" class="hidden p-4 space-y-4">
      <div class="bg-[#101829] border border-slate-800 rounded-xl p-3.5 space-y-3">
        <h3 class="text-xs font-bold text-cyan-400 uppercase tracking-wider">🎚️ 3-Track Cinema Audio Mixer</h3>

        <div class="space-y-2 text-xs">
          <div class="flex items-center justify-between">
            <span>🗣️ Track 1: Character Lip-Sync Dialogue (ElevenLabs / TTS)</span>
            <span id="volDialogueLabel" class="mono text-cyan-300">100%</span>
          </div>
          <input id="volDialogue" type="range" min="0" max="1" step="0.05" value="1" oninput="document.getElementById('volDialogueLabel').innerText=Math.round(this.value*100)+'%'" class="w-full accent-cyan-400" />
        </div>

        <div class="space-y-2 text-xs">
          <div class="flex items-center justify-between">
            <span>🎸 Track 2: Acoustic Folk Guitar Score (Auto-Ducks on Speech)</span>
            <button onclick="playAcousticChord()" class="px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 text-[11px]">Test Guitar</button>
          </div>
          <input id="volBgm" type="range" min="0" max="1" step="0.05" value="0.45" class="w-full accent-amber-400" />
        </div>

        <div class="space-y-2 text-xs">
          <div class="flex items-center justify-between">
            <span>💥 Track 3: Foley & Sound Effects (Car Trunk Slam / Engine)</span>
            <button onclick="playTrunkSlamSfx()" class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 text-[11px]">Test Trunk Slam SFX</button>
          </div>
          <input id="volSfx" type="range" min="0" max="1" step="0.05" value="0.85" class="w-full accent-emerald-400" />
        </div>
      </div>
    </section>

  </div>

  <!-- MODAL: EDIT SHOT PROMPT & KEYFRAME -->
  <div id="shotModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
    <div class="bg-[#0f172a] border border-slate-700 rounded-2xl max-w-md w-full p-4 space-y-3 text-xs">
      <div class="flex items-center justify-between">
        <h3 class="font-bold text-white text-sm">🎬 Edit Shot Prompt & Keyframe</h3>
        <button onclick="toggleModal('shotModal')" class="text-slate-400 hover:text-white">✕</button>
      </div>
      <input type="hidden" id="editShotIdx" />
      <div>
        <label class="block text-slate-400 mb-1">Shot Title</label>
        <input id="editShotTitle" type="text" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white" />
      </div>
      <div>
        <label class="block text-slate-400 mb-1">Visual Generation Prompt (Sent to Veo 3.1 / Kling 3.0)</label>
        <textarea id="editShotPrompt" rows="3" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white"></textarea>
      </div>
      <div class="grid grid-cols-2 gap-2">
        <div>
          <label class="block text-slate-400 mb-1">Speaker (@Character)</label>
          <input id="editShotSpeaker" type="text" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white" />
        </div>
        <div>
          <label class="block text-slate-400 mb-1">SFX Trigger</label>
          <select id="editShotSfx" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white">
            <option value="guitar">Acoustic Guitar Intro</option>
            <option value="slam">Heavy Car Trunk Slam</option>
            <option value="engine">Car Engine Acceleration</option>
          </select>
        </div>
      </div>
      <div>
        <label class="block text-slate-400 mb-1">Dialogue Line (Lip-Sync)</label>
        <input id="editShotDialogue" type="text" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white" />
      </div>
      <div class="flex justify-end gap-2 pt-2">
        <button onclick="toggleModal('shotModal')" class="px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300">Cancel</button>
        <button onclick="saveShotEdits()" class="px-4 py-1.5 rounded-lg font-bold bg-cyan-500 text-slate-950">Save Shot</button>
      </div>
    </div>
  </div>

  <!-- MODAL: API KEYS -->
  <div id="apiModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
    <div class="bg-[#0f172a] border border-slate-700 rounded-2xl max-w-md w-full p-4 space-y-3 text-xs">
      <div class="flex items-center justify-between">
        <h3 class="font-bold text-white text-sm">🔌 Connect Live Video & Voice APIs</h3>
        <button onclick="toggleModal('apiModal')" class="text-slate-400 hover:text-white">✕</button>
      </div>
      <div>
        <label class="block text-slate-400 mb-1">fal.ai API Key (Veo 3.1 / Kling 3.0 / FLUX)</label>
        <input id="falKey" type="password" placeholder="key_id:key_secret" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white mono" />
      </div>
      <div>
        <label class="block text-slate-400 mb-1">ElevenLabs API Key (Voice & SFX)</label>
        <input id="elevenKey" type="password" placeholder="sk_..." class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white mono" />
      </div>
      <div class="flex justify-end gap-2 pt-2">
        <button onclick="toggleModal('apiModal')" class="px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300">Close</button>
        <button onclick="saveKeys()" class="px-4 py-1.5 rounded-lg font-bold bg-cyan-500 text-slate-950">Save Keys</button>
      </div>
    </div>
  </div>

  <script>
    // --- PHOTOREALISTIC MULTI-SHOT STATE ---
    let cast = [
      {
        id: 'marcus',
        name: 'Marcus',
        role: 'PROT',
        avatar: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=200&auto=format&fit=crop&q=80',
        facePrompt: 'Young Black man, short afro, tan Carhartt work jacket, denim jeans',
        pitch: 1.0
      },
      {
        id: 'arthur',
        name: 'Arthur',
        role: 'PROT',
        avatar: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=200&auto=format&fit=crop&q=80',
        facePrompt: 'Older weathered farmer, plaid flannel shirt, standing by green tractor',
        pitch: 0.85
      }
    ];

    let shots = [
      {
        title: 'Shot 1: Wide Orchard Establishing',
        status: 'VIDEO READY',
        duration: 4.5,
        camera: 'Wide Aerial Drone Pan [0.8x]',
        speaker: 'Arthur',
        dialogue: 'You taking that heap? They judge an apple by how shiny the wax is, not the root.',
        prompt: 'Photorealistic wide morning shot of misty green farm harvest, pickup truck loaded with apple crates, golden hour sunlight',
        keyframe: 'https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=1000&auto=format&fit=crop&q=80',
        videoUrl: '',
        sfx: 'guitar',
        actors: ['Arthur', 'Marcus']
      },
      {
        title: 'Shot 2: Medium Two-Shot by Tractor',
        status: 'VIDEO READY',
        duration: 4.0,
        camera: 'Medium Two-Shot | 50mm Prime',
        speaker: 'Marcus',
        dialogue: "The turbo's for hauling grain, Dad.",
        prompt: 'Photorealistic medium two-shot of Marcus in tan Carhartt jacket wiping hands by open car trunk next to Arthur in flannel shirt by tractor',
        keyframe: 'https://images.unsplash.com/photo-1592982537447-7440770cbfc9?w=1000&auto=format&fit=crop&q=80',
        videoUrl: '',
        sfx: 'slam',
        actors: ['Marcus', 'Arthur']
      },
      {
        title: 'Shot 3: Highway Departure Toward Skyline',
        status: 'VIDEO READY',
        duration: 4.5,
        camera: 'Low Angle Rear Tracking Shot',
        speaker: 'Arthur',
        dialogue: "Then let 'em choke on the wax.",
        prompt: 'Vintage beige sedan driving down dirt orchard road through open farm gate toward distant city skyline in morning mist',
        keyframe: 'https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?w=1000&auto=format&fit=crop&q=80',
        videoUrl: '',
        sfx: 'engine',
        actors: ['Marcus']
      }
    ];

    let activeShotIdx = 0;
    let isPlaying = false;
    let playTimer = null;
    let currentTime = 0;
    let playbackRate = 1.0;
    let loopEnabled = true;
    let audioCtx = null;

    window.onload = () => {
      selectShot(0);
      renderCastStudio();
    };

    function switchTab(tab) {
      ['studio', 'script', 'mixer'].forEach(t => {
        document.getElementById(`tab-${t}`).classList.add('hidden');
        document.getElementById(`tabBtn-${t}`).className = 'py-1.5 rounded-lg text-slate-400 hover:text-white';
      });
      document.getElementById(`tab-${tab}`).classList.remove('hidden');
      document.getElementById(`tabBtn-${tab}`).className = 'py-1.5 rounded-lg bg-cyan-500/15 text-cyan-300 border border-cyan-500/40';
    }

    function toggleModal(id) {
      document.getElementById(id).classList.toggle('hidden');
    }

    // --- VIEWPORT & TIMELINE RENDERING ---
    function selectShot(idx) {
      stopPlayback();
      activeShotIdx = idx;
      const s = shots[idx];

      const img = document.getElementById('keyframeImg');
      const vid = document.getElementById('videoPlayer');

      if (s.videoUrl) {
        vid.src = s.videoUrl;
        vid.classList.remove('hidden');
        img.classList.add('hidden');
      } else {
        vid.classList.add('hidden');
        img.classList.remove('hidden');
        img.src = s.keyframe;
        // Restart smooth dolly animation
        img.classList.remove('animate-dolly');
        void img.offsetWidth;
        img.classList.add('animate-dolly');
      }

      document.getElementById('hudCameraSub').innerText = `🎥 ${s.camera}`;
      document.getElementById('cameraMoveSelect').value = s.camera;
      document.getElementById('subSpeaker').innerText = `${s.speaker.toUpperCase()}:`;
      document.getElementById('subText').innerText = `"${s.dialogue}"`;
      document.getElementById('timeTotal').innerText = `${s.duration.toFixed(1)}s`;
      document.getElementById('timeElapsed').innerText = `0.0s`;
      document.getElementById('scrubber').value = 0;

      // Render Locked Character Face Badges on Viewport
      const badgeContainer = document.getElementById('viewportCastBadges');
      badgeContainer.innerHTML = (s.actors || []).map(actorName => {
        const c = cast.find(x => x.name.toLowerCase() === actorName.toLowerCase());
        return c ? `
          <div class="flex items-center gap-1 px-2 py-0.5 rounded-full bg-slate-950/85 border border-cyan-500/40 text-[10px] text-cyan-200">
            <img src="${c.avatar}" class="w-3.5 h-3.5 rounded-full object-cover" />
            @${c.name} Locked
          </div>
        ` : '';
      }).join('');

      renderTimelineCards();
    }

    function renderTimelineCards() {
      document.getElementById('shotTotalBadge').innerText = shots.length;
      const list = document.getElementById('shotTimelineList');
      list.innerHTML = shots.map((s, i) => {
        const active = i === activeShotIdx;
        return `
          <div onclick="selectShot(${i})" class="cursor-pointer rounded-xl p-2.5 border transition flex items-center gap-3 ${active ? 'bg-[#122138] border-cyan-400 shadow-md' : 'bg-[#0e1627] border-slate-800 hover:border-slate-700'}">
            <div class="relative w-20 h-12 rounded-lg overflow-hidden flex-shrink-0 border border-slate-700">
              <img src="${s.keyframe}" class="w-full h-full object-cover" />
              <span class="absolute bottom-0.5 right-0.5 px-1 rounded bg-black/80 text-[9px] text-cyan-300 mono">${s.duration}s</span>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <span class="text-[10px] font-bold tracking-wider mono ${s.status === 'VIDEO READY' ? 'text-cyan-400' : 'text-amber-400'}">
                  SHOT ${i + 1} • ${s.status}
                </span>
                <span class="text-[10px] px-1.5 py-0.2 rounded bg-slate-800 text-slate-300 mono">🔊 ${s.sfx}</span>
              </div>
              <div class="text-xs font-bold text-white truncate">${s.title}</div>
              <div class="text-[11px] text-slate-400 truncate">🗣️ ${s.speaker}: "${s.dialogue}"</div>
            </div>
            <div class="flex items-center gap-1" onclick="event.stopPropagation()">
              <button onclick="openShotEditor(${i})" class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-cyan-300 text-xs" title="Edit Shot Prompt">
                ✏️
              </button>
              <button onclick="duplicateShot(${i})" class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs" title="Duplicate Shot">
                ❐
              </button>
              <button onclick="deleteShot(${i})" class="p-1.5 rounded-lg bg-slate-800 hover:bg-rose-900/60 text-slate-400 hover:text-rose-300 text-xs" title="Delete Shot">
                🗑️
              </button>
            </div>
          </div>
        `;
      }).join('');
    }

    // --- PLAYBACK, FULL MOVIE STITCHING & WEB AUDIO SFX ---
    function initAudio() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
    }

    function playAcousticChord() {
      initAudio();
      const vol = parseFloat(document.getElementById('volBgm')?.value || 0.4);
      const freqs = [196.00, 246.94, 293.66, 392.00]; // G Major warm acoustic chord
      freqs.forEach((f, idx) => {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(f, audioCtx.currentTime + idx * 0.06);
        gain.gain.setValueAtTime(vol * 0.15, audioCtx.currentTime + idx * 0.06);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 2.4);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(audioCtx.currentTime + idx * 0.06);
        osc.stop(audioCtx.currentTime + 2.4);
      });
    }

    function playTrunkSlamSfx() {
      initAudio();
      const vol = parseFloat(document.getElementById('volSfx')?.value || 0.85);
      // Heavy metallic thud synthesis
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(110, audioCtx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(28, audioCtx.currentTime + 0.28);
      gain.gain.setValueAtTime(vol * 0.6, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.32);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + 0.32);
    }

    function triggerShotSfx() {
      const s = shots[activeShotIdx];
      if (s.sfx === 'slam') playTrunkSlamSfx();
      else playAcousticChord();
    }

    function speakShotDialogue(shot, onEndCallback) {
      if (!('speechSynthesis' in window)) {
        if (onEndCallback) setTimeout(onEndCallback, shot.duration * 1000);
        return;
      }
      window.speechSynthesis.cancel();
      const utter = new SpeechSynthesisUtterance(shot.dialogue);
      const actor = cast.find(c => c.name.toLowerCase() === shot.speaker.toLowerCase());
      utter.pitch = actor ? actor.pitch : 1.0;
      utter.rate = playbackRate;
      utter.volume = parseFloat(document.getElementById('volDialogue')?.value || 1.0);
      if (onEndCallback) utter.onend = onEndCallback;
      window.speechSynthesis.speak(utter);
    }

    function togglePlayShot() {
      if (isPlaying) {
        stopPlayback();
      } else {
        startShotPlayback(false);
      }
    }

    function startShotPlayback(chainAllShots = false) {
      isPlaying = true;
      document.getElementById('playPauseBtn').innerText = '⏸';
      const shot = shots[activeShotIdx];
      currentTime = 0;

      // Play BGM + Shot SFX + Dialogue
      playAcousticChord();
      if (shot.sfx === 'slam') {
        setTimeout(() => playTrunkSlamSfx(), 1800);
      }
      speakShotDialogue(shot);

      clearInterval(playTimer);
      playTimer = setInterval(() => {
        currentTime += 0.1 * playbackRate;
        if (currentTime >= shot.duration) {
          if (chainAllShots && activeShotIdx < shots.length - 1) {
            selectShot(activeShotIdx + 1);
            startShotPlayback(true);
            return;
          } else if (loopEnabled && !chainAllShots) {
            currentTime = 0;
            speakShotDialogue(shot);
          } else {
            stopPlayback();
            return;
          }
        }
        document.getElementById('timeElapsed').innerText = `${currentTime.toFixed(1)}s`;
        document.getElementById('scrubber').value = Math.min(100, (currentTime / shot.duration) * 100);
      }, 100);
    }

    function stopPlayback() {
      isPlaying = false;
      clearInterval(playTimer);
      if ('speechSynthesis' in window) window.speechSynthesis.cancel();
      const btn = document.getElementById('playPauseBtn');
      if (btn) btn.innerText = '▶';
    }

    function stitchAndPlayFullMovie() {
      switchTab('studio');
      selectShot(0);
      startShotPlayback(true);
    }

    function auditionCurrentShot() {
      startShotPlayback(false);
    }

    // --- SHOT EDITING & GENERATION ACTIONS ---
    function openShotEditor(idx) {
      const s = shots[idx];
      document.getElementById('editShotIdx').value = idx;
      document.getElementById('editShotTitle').value = s.title;
      document.getElementById('editShotPrompt').value = s.prompt;
      document.getElementById('editShotSpeaker').value = s.speaker;
      document.getElementById('editShotDialogue').value = s.dialogue;
      document.getElementById('editShotSfx').value = s.sfx || 'guitar';
      toggleModal('shotModal');
    }

    function saveShotEdits() {
      const idx = parseInt(document.getElementById('editShotIdx').value, 10);
      shots[idx].title = document.getElementById('editShotTitle').value;
      shots[idx].prompt = document.getElementById('editShotPrompt').value;
      shots[idx].speaker = document.getElementById('editShotSpeaker').value;
      shots[idx].dialogue = document.getElementById('editShotDialogue').value;
      shots[idx].sfx = document.getElementById('editShotSfx').value;
      toggleModal('shotModal');
      selectShot(idx);
    }

    async function renderActiveShot() {
      const s = shots[activeShotIdx];
      s.status = 'RENDERING...';
      renderTimelineCards();

      const falKey = localStorage.getItem('storycast_fal_key');
      const model = document.getElementById('engineSelect').value;

      if (falKey) {
        try {
          const res = await fetch(`https://fal.run/${model}`, {
            method: 'POST',
            headers: { 'Authorization': `Key ${falKey}`, 'Content-Type': 'application/json' },
            body: JSON.stringify({ prompt: s.prompt, image_url: s.keyframe, aspect_ratio: '16:9' })
          });
          const data = await res.json();
          if (data?.video?.url) s.videoUrl = data.video.url;
        } catch (e) {}
      }

      setTimeout(() => {
        s.status = 'VIDEO READY';
        selectShot(activeShotIdx);
        startShotPlayback(false);
      }, 900);
    }

    function renderAllShotsBatch() {
      shots.forEach(s => s.status = 'VIDEO READY');
      renderTimelineCards();
      stitchAndPlayFullMovie();
    }

    function extendActiveShot() {
      shots[activeShotIdx].duration += 5.0;
      selectShot(activeShotIdx);
    }

    function addNewBlankShot() {
      shots.push({
        title: `Shot ${shots.length + 1}: Close-Up Reaction`,
        status: 'READY TO RENDER',
        duration: 4.0,
        camera: 'Over-The-Shoulder Close-Up',
        speaker: 'Marcus',
        dialogue: "We'll see who's right at the market.",
        prompt: 'Cinematic close-up shot in golden hour orchard lighting, shallow depth of field',
        keyframe: 'https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=1000&auto=format&fit=crop&q=80',
        videoUrl: '',
        sfx: 'guitar',
        actors: ['Marcus']
      });
      selectShot(shots.length - 1);
    }

    function duplicateShot(idx) {
      shots.splice(idx + 1, 0, JSON.parse(JSON.stringify(shots[idx])));
      renderTimelineCards();
    }

    function deleteShot(idx) {
      if (shots.length <= 1) return;
      shots.splice(idx, 1);
      selectShot(Math.max(0, idx - 1));
    }

    function loadCustomMp4(e) {
      const file = e.target.files[0];
      if (!file) return;
      const url = URL.createObjectURL(file);
      shots[activeShotIdx].videoUrl = url;
      shots[activeShotIdx].status = 'MP4 LOADED';
      selectShot(activeShotIdx);
    }

    function loadCustomKeyframe(e) {
      const file = e.target.files[0];
      if (!file) return;
      const url = URL.createObjectURL(file);
      shots[activeShotIdx].keyframe = url;
      shots[activeShotIdx].videoUrl = '';
      selectShot(activeShotIdx);
    }

    function applyColorGrade() {
      const filter = document.getElementById('lookSelect').value;
      document.getElementById('keyframeImg').style.filter = filter;
      document.getElementById('videoPlayer').style.filter = filter;
    }

    function updateActiveCameraMove(val) {
      shots[activeShotIdx].camera = val;
      document.getElementById('hudCameraSub').innerText = `🎥 ${val}`;
    }

    function toggleLoop() {
      loopEnabled = !loopEnabled;
      document.getElementById('loopToggleBtn').innerText = `Loop: ${loopEnabled ? 'ON' : 'OFF'}`;
    }

    function cycleSpeed() {
      const speeds = [0.8, 1.0, 1.25, 1.5];
      playbackRate = speeds[(speeds.indexOf(playbackRate) + 1) % speeds.length];
      document.getElementById('speedBtn').innerText = `${playbackRate}x`;
    }

    function scrubTimeline(val) {
      const s = shots[activeShotIdx];
      currentTime = (val / 100) * s.duration;
      document.getElementById('timeElapsed').innerText = `${currentTime.toFixed(1)}s`;
    }

    function toggleFullscreen() {
      const el = document.getElementById('viewportContainer');
      if (!document.fullscreenElement) el.requestFullscreen?.();
      else document.exitFullscreen?.();
    }

    // --- CAST & SCRIPT SYNC ---
    function renderCastStudio() {
      document.getElementById('castBadgeCount').innerText = cast.length;
      const container = document.getElementById('castStudioList');
      container.innerHTML = cast.map((c, idx) => `
        <div class="bg-[#101829] border border-slate-800 rounded-xl p-3 flex items-center justify-between gap-3">
          <div class="flex items-center gap-2.5">
            <img src="${c.avatar}" class="w-10 h-10 rounded-xl object-cover border border-cyan-400" />
            <div>
              <div class="text-xs font-bold text-white">@${c.name} <span class="text-[10px] text-emerald-400 mono">🔓 Face & Voice Unlocked</span></div>
              <input type="text" value="${c.facePrompt}" onchange="cast[${idx}].facePrompt=this.value"
                class="mt-1 w-64 bg-slate-900 border border-slate-700 rounded px-2 py-0.5 text-[11px] text-slate-200" />
            </div>
          </div>
          <button onclick="speakShotDialogue({speaker:'${c.name}', dialogue:'Voice & face lock active for ${c.name}.', duration:2})"
            class="px-2.5 py-1 rounded-lg bg-purple-500/20 text-purple-300 text-[11px] border border-purple-500/30">
            🔊 Test
          </button>
        </div>
      `).join('');
    }

    function addCastMember() {
      const name = prompt('Enter new Character Name (without @):', 'Elena');
      if (!name) return;
      cast.push({
        id: name.toLowerCase(),
        name,
        role: 'SIDE',
        avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=200&auto=format&fit=crop&q=80',
        facePrompt: 'Cinematic character portrait, natural lighting',
        pitch: 1.1
      });
      renderCastStudio();
    }

    function autoBreakScriptIntoShots() {
      const lines = document.getElementById('masterScript').value.split('\n').filter(l => l.includes(':'));
      if (lines.length) {
        lines.forEach((line, i) => {
          const [speakerRaw, ...rest] = line.split(':');
          const speaker = speakerRaw.replace('@', '').trim();
          const dialogue = rest.join(':').replace(/\[.*?\]/g, '').replace(/"/g, '').trim();
          if (shots[i]) {
            shots[i].speaker = speaker;
            shots[i].dialogue = dialogue;
          }
        });
        selectShot(0);
        switchTab('studio');
      }
    }

    function saveKeys() {
      localStorage.setItem('storycast_fal_key', document.getElementById('falKey').value.trim());
      localStorage.setItem('storycast_eleven_key', document.getElementById('elevenKey').value.trim());
      document.getElementById('connStatus').innerText = 'Live fal.ai & ElevenLabs Connected';
      toggleModal('apiModal');
    }

    function downloadActiveShotInfo() {
      const s = shots[activeShotIdx];
      if (s.videoUrl) {
        const a = document.createElement('a');
        a.href = s.videoUrl;
        a.download = `${s.title}.mp4`;
        a.click();
      } else {
        alert(`Shot "${s.title}" exported with prompt:\n${s.prompt}`);
      }
    }
  </script>
</body>
