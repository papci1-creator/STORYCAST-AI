<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>STORYCAST AI PRO — Production Studio</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');
    body {
      font-family: 'Inter', sans-serif;
      background-color: #080d16;
      color: #e2e8f0;
    }
    .mono { font-family: 'JetBrains Mono', monospace; }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #0f172a; }
    ::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
  </style>
</head>
<body class="min-h-screen flex flex-col items-center p-3 md:p-6">

  <!-- Main Studio Container -->
  <div class="w-full max-w-2xl bg-[#0c1322] border border-slate-800 rounded-2xl shadow-2xl overflow-hidden">

    <!-- Top Header -->
    <header class="flex items-center justify-between px-4 py-3 bg-[#090f1c] border-b border-slate-800/80">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-lg bg-cyan-500/10 border border-cyan-400/40 flex items-center justify-center text-cyan-400 font-bold">
          🎬
        </div>
        <div>
          <h1 class="text-sm font-bold tracking-wider text-white flex items-center gap-2">
            STORYCAST AI <span class="text-[10px] px-1.5 py-0.5 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">PRO</span>
          </h1>
          <div class="flex items-center gap-1.5 text-[11px] text-emerald-400 mono">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span id="apiStatusBadge">Pipeline Ready (Demo / API)</span>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button onclick="toggleApiModal()" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-cyan-300 border border-cyan-500/30 transition flex items-center gap-1.5">
          ⚙️ API Keys
        </button>
        <button onclick="exportMovie()" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-amber-500 hover:bg-amber-400 text-slate-950 transition">
          ↓ EXPORT
        </button>
      </div>
    </header>

    <!-- Navigation Tabs -->
    <div class="grid grid-cols-3 gap-1 p-2 bg-[#0b111e] border-b border-slate-800/80 text-xs font-medium">
      <button onclick="switchTab('script')" id="tabBtn-script" class="py-2 rounded-lg bg-cyan-500/15 text-cyan-300 border border-cyan-500/40 transition">
        📄 Script & Shots
      </button>
      <button onclick="switchTab('cast')" id="tabBtn-cast" class="py-2 rounded-lg text-slate-400 hover:text-white transition">
        👥 Cast & Face/Voice (<span id="castCount">2</span>)
      </button>
      <button onclick="switchTab('pipeline')" id="tabBtn-pipeline" class="py-2 rounded-lg text-slate-400 hover:text-white transition">
        ⚡ Shot Breakdown
      </button>
    </div>

    <!-- TAB 1: SCRIPT & SCREENPLAY -->
    <section id="tab-script" class="p-4 space-y-4">
      <!-- Character Tag Bar -->
      <div class="bg-[#111a2e] border border-slate-800 rounded-xl p-3">
        <div class="flex items-center justify-between text-[11px] text-slate-400 mb-2 mono">
          <span>🏷️ TAG CHARACTER TO SCENE:</span>
          <span>Click to insert @handle</span>
        </div>
        <div id="characterTagList" class="flex flex-wrap gap-2"></div>
      </div>

      <!-- AI Auto-Complete Bar -->
      <div class="bg-[#111a2e] border border-slate-800 rounded-xl p-3 flex flex-wrap items-center justify-between gap-2">
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="text-xs font-semibold text-cyan-400 mr-1">✨ AI Director:</span>
          <button onclick="aiAssist('dialogue')" class="px-2.5 py-1 rounded-md text-xs bg-purple-500/20 text-purple-300 border border-purple-500/40 hover:bg-purple-500/30">+ Dialogue</button>
          <button onclick="aiAssist('scene')" class="px-2.5 py-1 rounded-md text-xs bg-amber-500/20 text-amber-300 border border-amber-500/40 hover:bg-amber-500/30">+ Camera Shot</button>
          <button onclick="aiAssist('sfx')" class="px-2.5 py-1 rounded-md text-xs bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 hover:bg-emerald-500/30">+ SFX Beat</button>
        </div>
        <span id="wordCounter" class="text-[11px] text-slate-400 mono">0 words</span>
      </div>

      <!-- Script Textarea -->
      <div>
        <textarea id="scriptInput" rows="5" oninput="updateWordCount()"
          class="w-full bg-[#070b14] border border-slate-700/80 focus:border-cyan-400 rounded-xl p-3 text-xs text-slate-200 mono leading-relaxed outline-none"
          placeholder="Write your scene with @Character tags...">[SCENE 1: EXT. APPLE ORCHARD - MORNING]
Wide aerial shot of a misty farm harvest. Acoustic guitar music plays softly.

@Marcus stands beside a vintage Mercedes with the trunk open, wiping his hands with a shop rag. @Arthur stands next to a green tractor.

@Arthur: "You taking that heap? They judge an apple by how shiny the wax is, not the root."
@Marcus: "The turbo's for hauling grain, Dad." [SFX: Heavy car trunk slams shut]
@Arthur: "Then let 'em choke on the wax."</textarea>
      </div>

      <!-- Generate Video Engine CTA -->
      <button id="generateBtn" onclick="runGenerationPipeline()"
        class="w-full py-3 rounded-xl font-bold text-xs tracking-wider uppercase bg-gradient-to-r from-cyan-400 via-teal-300 to-amber-400 text-slate-950 shadow-lg hover:opacity-95 transition flex items-center justify-center gap-2">
        <span>🪄 GENERATE MULTI-SHOT VIDEO ENGINE</span>
      </button>

      <!-- Live Pipeline Progress Log -->
      <div id="pipelineLogBox" class="hidden bg-[#070b14] border border-cyan-500/30 rounded-xl p-3 text-[11px] mono space-y-1 text-cyan-300"></div>
    </section>

    <!-- TAB 2: CAST & UNLOCKED FACE / VOICE -->
    <section id="tab-cast" class="hidden p-4 space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-xs font-bold uppercase tracking-wider text-cyan-400">Unlocked Cast Identity & Voice Studio</h2>
          <p class="text-[11px] text-slate-400">Upload face references for FLUX/Kling & assign ElevenLabs voice IDs.</p>
        </div>
        <button onclick="openCastModal()" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-cyan-500 text-slate-950 hover:bg-cyan-400">
          + Add Character
        </button>
      </div>

      <div id="castGrid" class="grid grid-cols-1 md:grid-cols-2 gap-3"></div>
    </section>

    <!-- TAB 3: AI SHOT BREAKDOWN -->
    <section id="tab-pipeline" class="hidden p-4 space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-xs font-bold uppercase tracking-wider text-cyan-400">Generated Multi-Shot Storyboard</h2>
        <span class="text-[11px] text-slate-400 mono" id="engineModelLabel">Engine: Veo 3.1 / Kling 3.0</span>
      </div>
      <div id="shotBreakdownList" class="space-y-2 text-xs"></div>
    </section>

    <!-- VIDEO PREVIEW & TIMELINE PLAYER -->
    <section class="p-4 bg-[#080d18] border-t border-slate-800 space-y-3">
      <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
          <span id="activeSceneTitle" class="font-semibold text-white">Shot 1: Wide Orchard Establishing</span>
        </div>
        <div class="flex items-center gap-2">
          <select id="videoModelSelect" class="bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 text-[11px] text-cyan-300">
            <option value="fal-ai/veo3">Google Veo 3.1 (Native Audio + Video)</option>
            <option value="fal-ai/kling-video/v2/master/image-to-video">Kling 3.0 Master (Face Consistency)</option>
            <option value="fal-ai/runway-gen4">Runway Gen-4 Turbo</option>
          </select>
          <span class="px-2 py-1 rounded bg-cyan-500/10 text-cyan-300 border border-cyan-500/30 text-[11px] mono">16:9</span>
        </div>
      </div>

      <!-- Video Viewport (Real Video + Canvas Fallback) -->
      <div class="relative w-full aspect-video bg-black rounded-xl overflow-hidden border border-slate-800">
        <video id="realVideoPlayer" class="hidden w-full h-full object-cover" controls playsinline></video>
        <canvas id="previewCanvas" width="640" height="360" class="w-full h-full object-cover"></canvas>

        <!-- Camera HUD Overlay -->
        <div class="absolute top-3 left-3 right-3 flex items-center justify-between pointer-events-none">
          <div class="px-2.5 py-1 rounded-md bg-slate-950/80 border border-slate-700/80 text-[11px] text-cyan-300 mono">
            🎥 <span id="hudCameraText">CAMERA: Slow Dolly In [1.0x]</span>
          </div>
          <div class="px-2 py-0.5 rounded bg-emerald-500/20 border border-emerald-500/40 text-[10px] text-emerald-300 mono">
            LIP-SYNC: ACTIVE
          </div>
        </div>

        <!-- Subtitle Overlay -->
        <div class="absolute bottom-12 inset-x-6 text-center pointer-events-none">
          <span id="hudDialogueText" class="px-3 py-1 rounded bg-black/75 text-white text-xs font-medium">
            "The turbo's for hauling grain, Dad."
          </span>
        </div>

        <!-- Play Button Overlay -->
        <button onclick="togglePreviewPlayback()" class="absolute bottom-3 left-3 px-3 py-1 rounded-lg bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-xs shadow">
          ▶ Play / Audition Scene
        </button>
      </div>

      <!-- Interactive Multi-Shot Timeline Bar -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between text-[11px] text-slate-400 mono">
          <span>INTERACTIVE MULTI-SHOT TIMELINE</span>
          <span id="shotCountLabel">3 Shots Sequenced</span>
        </div>
        <div id="timelineContainer" class="grid grid-cols-3 gap-2"></div>
      </div>
    </section>
  </div>

  <!-- MODAL 1: API KEYS CONFIGURATION -->
  <div id="apiModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
    <div class="bg-[#0f172a] border border-slate-700 rounded-2xl max-w-md w-full p-5 space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-bold text-white">🔌 Real AI Video & Voice API Keys</h3>
        <button onclick="toggleApiModal()" class="text-slate-400 hover:text-white text-sm">✕</button>
      </div>
      <p class="text-xs text-slate-400">
        Keys are stored locally in your browser (`localStorage`) and connect your app directly to the generation endpoints.
      </p>
      <div class="space-y-3 text-xs">
        <div>
          <label class="block text-slate-300 mb-1 font-medium">1. Gemini API Key (Script-to-Shot Director)</label>
          <input id="geminiKeyInput" type="password" placeholder="AIzaSy..." class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white mono" />
        </div>
        <div>
          <label class="block text-slate-300 mb-1 font-medium">2. fal.ai API Key (Veo 3.1, Kling 3.0, FLUX, Sync.so)</label>
          <input id="falKeyInput" type="password" placeholder="key_id:key_secret" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white mono" />
        </div>
        <div>
          <label class="block text-slate-300 mb-1 font-medium">3. ElevenLabs API Key (Voice Acting & SFX)</label>
          <input id="elevenKeyInput" type="password" placeholder="sk_..." class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white mono" />
        </div>
      </div>
      <div class="flex justify-end gap-2 pt-2">
        <button onclick="toggleApiModal()" class="px-3 py-1.5 rounded-lg text-xs bg-slate-800 text-slate-300">Cancel</button>
        <button onclick="saveApiKeys()" class="px-4 py-1.5 rounded-lg text-xs font-bold bg-cyan-500 text-slate-950">Save & Connect</button>
      </div>
    </div>
  </div>

  <!-- MODAL 2: UNLOCKED CHARACTER FACE & VOICE EDITOR -->
  <div id="castModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
    <div class="bg-[#0f172a] border border-slate-700 rounded-2xl max-w-md w-full p-5 space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-bold text-white">🎭 Edit Character Face & Voice</h3>
        <button onclick="closeCastModal()" class="text-slate-400 hover:text-white text-sm">✕</button>
      </div>
      <input type="hidden" id="editCharId" />
      <div class="space-y-3 text-xs">
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-slate-400 mb-1">Handle (@Name)</label>
            <input id="charNameInput" type="text" placeholder="Marcus" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white" />
          </div>
          <div>
            <label class="block text-slate-400 mb-1">Role</label>
            <select id="charRoleInput" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white">
              <option value="PROT">PROT (Lead)</option>
              <option value="SIDE">SIDE (Supporting)</option>
              <option value="ANTA">ANTA (Antagonist)</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-slate-400 mb-1">Upload Face Reference Photo (Unlocked)</label>
          <input id="charFaceFile" type="file" accept="image/*" onchange="handleFaceUpload(event)" class="w-full text-slate-300 text-[11px]" />
        </div>
        <div>
          <label class="block text-slate-400 mb-1">Visual & Wardrobe Prompt (For FLUX / Kling Consistency)</label>
          <input id="charFacePrompt" type="text" placeholder="Young Black man, short afro, tan Carhartt work jacket" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white" />
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-slate-400 mb-1">ElevenLabs Voice ID / Preset</label>
            <select id="charVoiceInput" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white">
              <option value="pNInz6obpgDQGcFmaJgB">Adam (Deep Cinematic)</option>
              <option value="TxGEqnHWrfWFTfGW9XjX">Josh (Warm Baritone)</option>
              <option value="EXAVITQu4vr4xnSDxMaL">Bella (Expressive Lead)</option>
              <option value="VR6AewLTigWG4xSOukaG">Arnold (Gravelly Veteran)</option>
            </select>
          </div>
          <div>
            <label class="block text-slate-400 mb-1">Voice Pitch (<span id="pitchVal">1.0</span>)</label>
            <input id="charPitchInput" type="range" min="0.7" max="1.3" step="0.1" value="1.0" oninput="document.getElementById('pitchVal').innerText=this.value" class="w-full mt-2" />
          </div>
        </div>
      </div>
      <div class="flex justify-between items-center pt-2">
        <button onclick="auditionCharacterVoice()" class="px-3 py-1.5 rounded-lg text-xs bg-purple-500/20 text-purple-300 border border-purple-500/40">
          🔊 Audition Voice
        </button>
        <div class="flex gap-2">
          <button onclick="closeCastModal()" class="px-3 py-1.5 rounded-lg text-xs bg-slate-800 text-slate-300">Cancel</button>
          <button onclick="saveCharacter()" class="px-4 py-1.5 rounded-lg text-xs font-bold bg-cyan-500 text-slate-950">Save Character</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // --- STATE ---
    let uploadedFaceDataUrl = '';
    let cast = [
      {
        id: 'c1',
        name: 'Marcus',
        role: 'PROT',
        faceUnlocked: true,
        voiceUnlocked: true,
        avatar: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=160&auto=format&fit=crop&q=80',
        facePrompt: 'Young Black man, short afro, tan Carhartt jacket, denim jeans',
        voiceId: 'TxGEqnHWrfWFTfGW9XjX',
        pitch: 1.0
      },
      {
        id: 'c2',
        name: 'Arthur',
        role: 'PROT',
        faceUnlocked: true,
        voiceUnlocked: true,
        avatar: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=160&auto=format&fit=crop&q=80',
        facePrompt: 'Older weathered farmer, plaid flannel shirt, standing by tractor',
        voiceId: 'VR6AewLTigWG4xSOukaG',
        pitch: 0.9
      }
    ];

    let shots = [
      {
        title: 'Shot 1: Wide Orchard Establishing',
        camera: 'Wide Aerial Drone Pan [0.8x]',
        prompt: 'Wide establishing shot of a misty green farm orchard at sunrise, workers loading apple crates by a pickup truck',
        dialogue: 'You taking that heap? They judge an apple by how shiny the wax is, not the root.',
        speaker: 'Arthur',
        videoUrl: ''
      },
      {
        title: 'Shot 2: Medium Two-Shot by Tractor',
        camera: 'Medium Two-Shot | 50mm Lens',
        prompt: 'Medium shot of @Marcus in a tan Carhartt jacket wiping his hands by a vintage beige Mercedes trunk next to @Arthur in a plaid shirt by a green tractor',
        dialogue: "The turbo's for hauling grain, Dad.",
        speaker: 'Marcus',
        videoUrl: ''
      },
      {
        title: 'Shot 3: Highway Departure Toward Skyline',
        camera: 'Low Angle Rear Tracking Shot',
        prompt: 'Vintage beige Mercedes driving down a dirt farm road through open gates toward a distant city skyline in morning mist',
        dialogue: "Then let 'em choke on the wax.",
        speaker: 'Arthur',
        videoUrl: ''
      }
    ];

    let activeShotIndex = 0;

    // --- INITIALIZATION ---
    window.onload = () => {
      loadApiKeys();
      renderCastTags();
      renderCastCards();
      renderShots();
      updateWordCount();
      drawCanvasScene();
    };

    function switchTab(tab) {
      ['script', 'cast', 'pipeline'].forEach(t => {
        document.getElementById(`tab-${t}`).classList.add('hidden');
        document.getElementById(`tabBtn-${t}`).className = 'py-2 rounded-lg text-slate-400 hover:text-white transition';
      });
      document.getElementById(`tab-${tab}`).classList.remove('hidden');
      document.getElementById(`tabBtn-${tab}`).className = 'py-2 rounded-lg bg-cyan-500/15 text-cyan-300 border border-cyan-500/40 transition';
    }

    // --- API KEY MANAGEMENT ---
    function toggleApiModal() {
      document.getElementById('apiModal').classList.toggle('hidden');
    }

    function loadApiKeys() {
      const gemini = localStorage.getItem('storycast_gemini_key') || '';
      const fal = localStorage.getItem('storycast_fal_key') || '';
      const eleven = localStorage.getItem('storycast_eleven_key') || '';
      document.getElementById('geminiKeyInput').value = gemini;
      document.getElementById('falKeyInput').value = fal;
      document.getElementById('elevenKeyInput').value = eleven;

      const status = document.getElementById('apiStatusBadge');
      if (gemini || fal || eleven) {
        status.innerText = 'Live API Keys Connected';
      } else {
        status.innerText = 'Simulation Mode (Add Keys for Live AI)';
      }
    }

    function saveApiKeys() {
      localStorage.setItem('storycast_gemini_key', document.getElementById('geminiKeyInput').value.trim());
      localStorage.setItem('storycast_fal_key', document.getElementById('falKeyInput').value.trim());
      localStorage.setItem('storycast_eleven_key', document.getElementById('elevenKeyInput').value.trim());
      loadApiKeys();
      toggleApiModal();
    }

    // --- CAST & UNLOCKED FACE/VOICE STUDIO ---
    function renderCastTags() {
      const container = document.getElementById('characterTagList');
      document.getElementById('castCount').innerText = cast.length;
      container.innerHTML = cast.map(c => `
        <button onclick="insertTag('@${c.name}')" class="px-2.5 py-1 rounded-lg text-xs font-medium bg-emerald-500/15 text-emerald-300 border border-emerald-500/40 hover:bg-emerald-500/25 flex items-center gap-1.5">
          <img src="${c.avatar}" class="w-4 h-4 rounded-full object-cover" />
          @${c.name} <span class="text-[10px] opacity-75">(${c.role}) ✓</span>
        </button>
      `).join('');
    }

    function renderCastCards() {
      const grid = document.getElementById('castGrid');
      grid.innerHTML = cast.map(c => `
        <div class="bg-[#111a2e] border border-slate-800 rounded-xl p-3 space-y-2.5">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <img src="${c.avatar}" class="w-11 h-11 rounded-xl object-cover border border-cyan-400/50" />
              <div>
                <div class="text-xs font-bold text-white">@${c.name} <span class="text-[10px] px-1.5 py-0.5 rounded bg-cyan-500/20 text-cyan-300">${c.role}</span></div>
                <div class="text-[11px] text-emerald-400 mono">🔓 Face & Voice Unlocked</div>
              </div>
            </div>
            <button onclick="openCastModal('${c.id}')" class="px-2.5 py-1 rounded-lg text-xs bg-slate-800 hover:bg-slate-700 text-cyan-300 border border-slate-700">
              Edit Face/Voice
            </button>
          </div>
          <p class="text-[11px] text-slate-300 bg-slate-900/80 p-2 rounded-lg border border-slate-800">
            <strong class="text-cyan-400">Face Prompt:</strong> ${c.facePrompt}
          </p>
          <div class="flex items-center justify-between text-[11px] text-slate-400 mono">
            <span>🎙️ Voice ID: ${c.voiceId.slice(0, 8)}...</span>
            <button onclick="speakLine('Hello, I am ${c.name}, ready for my scene.', ${c.pitch}, '${c.voiceId}')" class="text-purple-300 hover:underline">
              ▶ Test Voice
            </button>
          </div>
        </div>
      `).join('');
    }

    function openCastModal(id = '') {
      uploadedFaceDataUrl = '';
      const modal = document.getElementById('castModal');
      modal.classList.remove('hidden');
      if (id) {
        const c = cast.find(x => x.id === id);
        document.getElementById('editCharId').value = c.id;
        document.getElementById('charNameInput').value = c.name;
        document.getElementById('charRoleInput').value = c.role;
        document.getElementById('charFacePrompt').value = c.facePrompt;
        document.getElementById('charVoiceInput').value = c.voiceId;
        document.getElementById('charPitchInput').value = c.pitch;
        document.getElementById('pitchVal').innerText = c.pitch;
      } else {
        document.getElementById('editCharId').value = '';
        document.getElementById('charNameInput').value = '';
        document.getElementById('charFacePrompt').value = '';
      }
    }

    function closeCastModal() {
      document.getElementById('castModal').classList.add('hidden');
    }

    function handleFaceUpload(e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = ev => { uploadedFaceDataUrl = ev.target.result; };
      reader.readAsDataURL(file);
    }

    function saveCharacter() {
      const id = document.getElementById('editCharId').value;
      const name = document.getElementById('charNameInput').value.trim() || 'NewActor';
      const role = document.getElementById('charRoleInput').value;
      const facePrompt = document.getElementById('charFacePrompt').value.trim() || 'Cinematic character portrait';
      const voiceId = document.getElementById('charVoiceInput').value;
      const pitch = parseFloat(document.getElementById('charPitchInput').value);

      if (id) {
        const idx = cast.findIndex(x => x.id === id);
        cast[idx] = {
          ...cast[idx],
          name,
          role,
          facePrompt,
          voiceId,
          pitch,
          avatar: uploadedFaceDataUrl || cast[idx].avatar
        };
      } else {
        cast.push({
          id: 'c_' + Date.now(),
          name,
          role,
          faceUnlocked: true,
          voiceUnlocked: true,
          avatar: uploadedFaceDataUrl || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=160&auto=format&fit=crop&q=80',
          facePrompt,
          voiceId,
          pitch
        });
      }
      renderCastTags();
      renderCastCards();
      closeCastModal();
    }

    function auditionCharacterVoice() {
      const name = document.getElementById('charNameInput').value || 'Character';
      const pitch = parseFloat(document.getElementById('charPitchInput').value);
      const voiceId = document.getElementById('charVoiceInput').value;
      speakLine(`Testing voice synthesis for ${name}. Face and voice locks are synchronized.`, pitch, voiceId);
    }

    // --- SCRIPT HELPERS ---
    function insertTag(tag) {
      const el = document.getElementById('scriptInput');
      el.value += ` ${tag} `;
      updateWordCount();
    }

    function aiAssist(type) {
      const el = document.getElementById('scriptInput');
      if (type === 'dialogue') {
        el.value += `\n@${cast[0]?.name || 'Marcus'}: "We don't have much time before the storm hits the ridge."`;
      } else if (type === 'scene') {
        el.value += `\n[CAMERA: Close-up over-the-shoulder shot, shallow depth of field, golden hour lighting]`;
      } else if (type === 'sfx') {
        el.value += ` [SFX: Low tractor engine rumble, gravel crunching under tires]`;
      }
      updateWordCount();
    }

    function updateWordCount() {
      const text = document.getElementById('scriptInput').value.trim();
      const words = text ? text.split(/\s+/).length : 0;
      document.getElementById('wordCounter').innerText = `${words} words | ${text.length} chars`;
    }

    // --- REAL AI GENERATION PIPELINE (GEMINI + FAL.AI + ELEVENLABS) ---
    async function runGenerationPipeline() {
      const logBox = document.getElementById('pipelineLogBox');
      logBox.classList.remove('hidden');
      logBox.innerHTML = '';
      const log = msg => {
        logBox.innerHTML += `<div>▸ ${msg}</div>`;
      };

      const geminiKey = localStorage.getItem('storycast_gemini_key');
      const falKey = localStorage.getItem('storycast_fal_key');
      const selectedModel = document.getElementById('videoModelSelect').value;
      const scriptText = document.getElementById('scriptInput').value;

      log('Step 1/4: Synchronizing unlocked Cast Face Prompts & Voice IDs...');

      // 1. Parse Script into Multi-Shot Storyboard via Gemini API (if key provided)
      if (geminiKey) {
        try {
          log('Step 2/4: Calling Gemini 2.5 Flash API to break screenplay into camera shots...');
          const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${geminiKey}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              contents: [{
                parts: [{
                  text: `Break this screenplay into 3 cinematic video generation shots. Return ONLY valid JSON array with objects having keys: title, camera, prompt, dialogue, speaker. Script: ${scriptText}`
                }]
              }]
            })
          });
          const data = await res.json();
          const rawText = data?.candidates?.[0]?.content?.parts?.[0]?.text || '';
          const jsonMatch = rawText.match(/\[[\s\S]*\]/);
          if (jsonMatch) {
            shots = JSON.parse(jsonMatch[0]);
            log('✓ Gemini Director generated 3-shot camera storyboard.');
          }
        } catch (err) {
          log('⚠️ Gemini API fallback: Using built-in multi-shot parser.');
        }
      } else {
        log('Step 2/4: [Simulation] Parsed script into 3 connected camera angles.');
      }

      // 2. Call fal.ai Video Generation Engine (if key provided)
      if (falKey) {
        try {
          log(`Step 3/4: Sending Shot 1 + Character Face Reference to ${selectedModel} via fal.ai...`);
          const response = await fetch(`https://fal.run/${selectedModel}`, {
            method: 'POST',
            headers: {
              'Authorization': `Key ${falKey}`,
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              prompt: `${shots[0].prompt}. Characters: ${cast.map(c => c.facePrompt).join('; ')}`,
              aspect_ratio: '16:9'
            })
          });
          const result = await response.json();
          const videoUrl = result?.video?.url || result?.url || '';
          if (videoUrl) {
            shots[0].videoUrl = videoUrl;
            const vidEl = document.getElementById('realVideoPlayer');
            vidEl.src = videoUrl;
            vidEl.classList.remove('hidden');
            document.getElementById('previewCanvas').classList.add('hidden');
            log('✓ Live MP4 video stream received from fal.ai!');
          }
        } catch (err) {
          log('⚠️ fal.ai request requires proxy or valid balance; showing interactive canvas preview.');
        }
      } else {
        log(`Step 3/4: [Simulation] Rendering ${selectedModel} keyframes with Cast Face Consistency...`);
      }

      log('Step 4/4: Synchronizing ElevenLabs dialogue & lip-sync track...');
      renderShots();
      selectShot(0);
    }

    // --- VOICE SYNTHESIS (ELEVENLABS API + BROWSER FALLBACK) ---
    async function speakLine(text, pitch = 1.0, voiceId = 'TxGEqnHWrfWFTfGW9XjX') {
      const elevenKey = localStorage.getItem('storycast_eleven_key');
      if (elevenKey) {
        try {
          const res = await fetch(`https://api.elevenlabs.io/v1/text-to-speech/${voiceId}`, {
            method: 'POST',
            headers: {
              'xi-api-key': elevenKey,
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              text,
              model_id: 'eleven_multilingual_v2'
            })
          });
          if (res.ok) {
            const blob = await res.blob();
            const audio = new Audio(URL.createObjectURL(blob));
            audio.play();
            return;
          }
        } catch (e) {}
      }
      // Browser TTS Fallback
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const utter = new SpeechSynthesisUtterance(text);
        utter.pitch = pitch;
        window.speechSynthesis.speak(utter);
      }
    }

    // --- SHOT TIMELINE & CANVAS RENDERER ---
    function renderShots() {
      document.getElementById('shotCountLabel').innerText = `${shots.length} Shots Sequenced`;
      const timeline = document.getElementById('timelineContainer');
      timeline.innerHTML = shots.map((s, idx) => `
        <button onclick="selectShot(${idx})" class="p-2.5 rounded-xl text-left border transition ${idx === activeShotIndex ? 'bg-cyan-500/20 border-cyan-400 text-white' : 'bg-[#111a2e] border-slate-800 text-slate-400 hover:text-white'}">
          <div class="text-[10px] font-bold text-cyan-300 mono">SHOT ${idx + 1}</div>
          <div class="text-xs font-semibold truncate">${s.title}</div>
          <div class="text-[10px] text-slate-400 truncate mt-0.5">🗣️ ${s.speaker}: "${s.dialogue}"</div>
        </button>
      `).join('');

      const breakdown = document.getElementById('shotBreakdownList');
      breakdown.innerHTML = shots.map((s, idx) => `
        <div class="bg-[#111a2e] border border-slate-800 rounded-xl p-3 space-y-1">
          <div class="flex justify-between items-center">
            <span class="font-bold text-cyan-300">Shot ${idx + 1}: ${s.title}</span>
            <span class="text-[10px] mono px-2 py-0.5 rounded bg-slate-800 text-slate-300">${s.camera}</span>
          </div>
          <p class="text-[11px] text-slate-300"><strong>Visual Prompt:</strong> ${s.prompt}</p>
          <p class="text-[11px] text-emerald-300 mono"><strong>Lip-Sync Audio (${s.speaker}):</strong> "${s.dialogue}"</p>
        </div>
      `).join('');
    }

    function selectShot(index) {
      activeShotIndex = index;
      const shot = shots[index];
      document.getElementById('activeSceneTitle').innerText = shot.title;
      document.getElementById('hudCameraText').innerText = `CAMERA: ${shot.camera}`;
      document.getElementById('hudDialogueText').innerText = `${shot.speaker}: "${shot.dialogue}"`;
      renderShots();
      drawCanvasScene();
    }

    function togglePreviewPlayback() {
      const shot = shots[activeShotIndex];
      const speakerObj = cast.find(c => c.name.toLowerCase() === (shot.speaker || '').toLowerCase());
      speakLine(shot.dialogue, speakerObj?.pitch || 1.0, speakerObj?.voiceId);
      drawCanvasScene();
    }

    function drawCanvasScene() {
      const canvas = document.getElementById('previewCanvas');
      const ctx = canvas.getContext('2d');
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Golden Hour Morning Sky Gradient (matching the orchard video)
      const sky = ctx.createLinearGradient(0, 0, 0, canvas.height);
      sky.addColorStop(0, '#1e293b');
      sky.addColorStop(0.55, '#fbbf24');
      sky.addColorStop(0.6, '#14532d');
      sky.addColorStop(1, '#052e16');
      ctx.fillStyle = sky;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Distant Skyline / Barn Silhouette
      ctx.fillStyle = 'rgba(15, 23, 42, 0.55)';
      if (activeShotIndex === 2) {
        // City skyline on horizon for Shot 3
        [180, 210, 245, 275, 310, 350, 390, 420].forEach((x, i) => {
          const h = 45 + (i % 3) * 25;
          ctx.fillRect(x, 198 - h, 26, h);
        });
      } else {
        // Farm storage building
        ctx.fillRect(360, 155, 220, 45);
      }

      // Dirt Road Perspective
      ctx.fillStyle = '#78350f';
      ctx.beginPath();
      ctx.moveTo(260, 200);
      ctx.lineTo(380, 200);
      ctx.lineTo(520, 360);
      ctx.lineTo(120, 360);
      ctx.closePath();
      ctx.fill();

      // Actor Silhouettes / Car Frame Indicator
      ctx.fillStyle = '#0f172a';
      if (activeShotIndex === 1) {
        // Two-shot silhouettes
        ctx.beginPath();
        ctx.arc(240, 210, 26, 0, Math.PI * 2);
        ctx.arc(400, 205, 26, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillRect(205, 240, 70, 110);
        ctx.fillRect(365, 235, 70, 115);
      } else {
        // Vintage car silhouette
        ctx.fillRect(250, 235, 140, 55);
      }
    }

    function exportMovie() {
      const payload = {
        project: 'STORYCAST_AI_PRO',
        engine: document.getElementById('videoModelSelect').value,
        cast,
        shots
      };
      const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'storycast-project-timeline.json';
      a.click();
    }
  </script>
